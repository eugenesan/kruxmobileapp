+    def load_key_from_clipboard(self):
+        from .encryption_ui import decrypt_kef
+
+        data = self.paste_clipboard()
+
+        if data is None:
+            self.flash_error(t("Failed to load"))
+            return MENU_CONTINUE
+
+        words = []
+        try:
+            data_bytes = decrypt_kef(self.ctx, data)
