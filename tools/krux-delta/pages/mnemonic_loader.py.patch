+                from embit.bip39 import mnemonic_from_bytes
+
+                words = mnemonic_from_bytes(data_bytes).split()
+        except:
+            self.flash_error(t("Failed to load"))
+            return MENU_CONTINUE
+        
+        if not words:
+            self.flash_error(t("Failed to load"))
+            return MENU_CONTINUE
+
+        return self._load_key_from_words(words)    
